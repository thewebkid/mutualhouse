# Mutual House (`mutualhouse.org`) — Environment Configuration
# When DATABASE_URL is omitted in local development, the server automatically boots
# an embedded PostgreSQL 16 instance (PGlite) at ./.data/pglite so `npm run dev` and
# `npm test` work out of the box with real SQL transactions.

# Neon Serverless Postgres (provision via `vercel integration add neon`)
DATABASE_URL=

# Better Auth (32+ byte base64 secret; auto-generated locally in .data/dev-secret if unset)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5888

# House Ed25519 key encryption master key (32-byte hex; auto-generated locally in dev if unset)
HOUSE_KEY_MASTER_SECRET=

# Resend (leave RESEND_API_KEY unset locally so the instant Dev Magic Link toast shows in-app)
RESEND_API_KEY=
EMAIL_FROM="The Mutual House <porch@mail.mutualhouse.org>"

# Private Cloudflare R2 Bucket (optional locally: falls back to signed local store ./.data/r2-local)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mutualhouse-private

# Cloudflare Realtime TURN (optional locally: uses STUN locally when unset, TURN on cellular/NAT)
CF_TURN_TOKEN_ID=
CF_TURN_API_TOKEN=
